<UserControl x:Class="EmotionAnalyzer.Components.FeedbackForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    
    <Grid Background="#F8F9FA">
        <!-- Форма обратной связи -->
        <Border Background="#FFFFFF"
                BorderThickness="1"
                BorderBrush="#E0E0E0"
                CornerRadius="8"
                Padding="32"
                MaxWidth="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок формы -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="📝 Обратная связь"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#191919"
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Поделитесь вашими впечатлениями о анализе"
                               FontSize="14"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
                
                <!-- Поля формы -->
                <StackPanel Grid.Row="1" Margin="0,0,0,32">
                    <!-- ФИО -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="ФИО"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,6"/>
                        
                        <TextBox x:Name="NameTextBox"
                                 Height="40"
                                 FontSize="14"
                                 Padding="12"
                                 BorderThickness="1"
                                 BorderBrush="#CCCCCC"
                                 Background="#FFFFFF"
                                 Foreground="#191919"
                                 CaretBrush="#007ACC"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    
                    <!-- Возраст -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Возраст"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,6"/>
                        
                        <TextBox x:Name="AgeTextBox"
                                 Height="40"
                                 FontSize="14"
                                 Padding="12"
                                 BorderThickness="1"
                                 BorderBrush="#CCCCCC"
                                 Background="#FFFFFF"
                                 Foreground="#191919"
                                 CaretBrush="#007ACC"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                    
                    <!-- Пол -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Пол"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,6"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <!-- Мужской -->
                            <RadioButton x:Name="MaleRadioButton"
                                         Content="Мужской"
                                         GroupName="Gender"
                                         Margin="0,0,20,0"
                                         VerticalAlignment="Center"
                                         FontSize="14"
                                         Foreground="#333333"/>
                            
                            <!-- Женский -->
                            <RadioButton x:Name="FemaleRadioButton"
                                         Content="Женский"
                                         GroupName="Gender"
                                         VerticalAlignment="Center"
                                         FontSize="14"
                                         Foreground="#333333"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Оценка видеоролика -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Оцените видеоролик"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#333333"
                                   Margin="0,0,0,6"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <!-- Звезды для оценки -->
                            <Button x:Name="Star1" Content="★" Tag="1" Click="StarButton_Click" 
                                    Width="40" Height="40" FontSize="24" Background="Transparent" 
                                    BorderBrush="Transparent" Foreground="LightGray" Cursor="Hand"/>
                            <Button x:Name="Star2" Content="★" Tag="2" Click="StarButton_Click" 
                                    Width="40" Height="40" FontSize="24" Background="Transparent" 
                                    BorderBrush="Transparent" Foreground="LightGray" Cursor="Hand"/>
                            <Button x:Name="Star3" Content="★" Tag="3" Click="StarButton_Click" 
                                    Width="40" Height="40" FontSize="24" Background="Transparent" 
                                    BorderBrush="Transparent" Foreground="LightGray" Cursor="Hand"/>
                            <Button x:Name="Star4" Content="★" Tag="4" Click="StarButton_Click" 
                                    Width="40" Height="40" FontSize="24" Background="Transparent" 
                                    BorderBrush="Transparent" Foreground="LightGray" Cursor="Hand"/>
                            <Button x:Name="Star5" Content="★" Tag="5" Click="StarButton_Click" 
                                    Width="40" Height="40" FontSize="24" Background="Transparent" 
                                    BorderBrush="Transparent" Foreground="LightGray" Cursor="Hand"/>
                        </StackPanel>
                        
                        <TextBlock x:Name="RatingText"
                                   Text="Выберите оценку"
                                   FontSize="12"
                                   Foreground="#666666"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Кнопки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Кнопка отмены -->
                    <Button x:Name="CancelButton"
                            Content="Отмена"
                            Width="120"
                            Height="40"
                            FontSize="14"
                            Background="Transparent"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Foreground="#666666"
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="15,8">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                    <Setter Property="Foreground" Value="#333333"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Кнопка отправки -->
                    <Button x:Name="SubmitButton"
                            Content="Отправить"
                            Width="120"
                            Height="40"
                            FontSize="14"
                            Background="#007ACC"
                            BorderBrush="#005A9E"
                            BorderThickness="1"
                            Foreground="White"
                            Cursor="Hand"
                            Click="SubmitButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="15,8">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#005A9E"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#004A8E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>