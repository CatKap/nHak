<UserControl x:Class="EmotionAnalyzer.Components.CalibrationWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="600"
             Height="400">
    
    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"
            CornerRadius="12"
            Padding="40">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Иконка устройства -->
            <Grid Grid.Row="0"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,24">
                <Ellipse Width="80"
                         Height="80"
                         Fill="#F0F8FF"/>
                
                <TextBlock Text="📷"
                           FontSize="36"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
            
            <!-- Сообщение о подключении -->
            <TextBlock Grid.Row="1"
                       Text="Устройство подключено"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#1E90FF"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>
            
            <!-- Начинается калибровка -->
            <TextBlock Grid.Row="2"
                       Text="Начинается калибровка..."
                       FontSize="18"
                       FontWeight="Medium"
                       Foreground="#333333"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,32"/>
            
            <!-- Инструкция -->
            <Border Grid.Row="3"
                    Background="#FFF5E6"
                    CornerRadius="8"
                    Padding="24,16"
                    Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="⚠️ ВНИМАНИЕ"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#FF8C00"
                               Margin="0,0,0,8"
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Не двигайтесь и не думайте ни о чём"
                               FontSize="16"
                               Foreground="#333333"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Таймер прогресса -->
            <StackPanel Grid.Row="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,20">
                
                <!-- Прогресс-бар -->
                <Border Width="300"
                        Height="12"
                        Background="#EBEBEB"
                        CornerRadius="6"
                        Margin="0,0,0,16">
                    <Border x:Name="ProgressFill"
                            Width="0"
                            Height="12"
                            Background="#1E90FF"
                            CornerRadius="6"
                            HorizontalAlignment="Left"/>
                </Border>
                
                <!-- Время -->
                <TextBlock x:Name="TimerText"
                           Text="20 секунд"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1E90FF"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            
            <!-- Кнопка отмены -->
            <Button Grid.Row="5"
                    x:Name="CancelButton"
                    Content="Отменить калибровку"
                    Width="180"
                    Height="40"
                    FontSize="14"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="#CCCCCC"
                    Foreground="#666666"
                    HorizontalAlignment="Center"
                    Cursor="Hand"
                    Click="CancelButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="15,8">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>