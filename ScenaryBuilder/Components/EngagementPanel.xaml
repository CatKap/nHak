<UserControl x:Class="EmotionAnalyzer.Components.EngagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"  
            CornerRadius="8"
            Padding="24">
        
        <Grid SnapsToDevicePixels="True"
          UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок и статус -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Вовлечённость"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#000000"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                
                <TextBlock Text="Очень вовлечён"
                           FontSize="14"
                           Foreground="#1E90FF"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
            
            <!-- Переключатель временных интервалов -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                <Button x:Name="TimeIntervalFull"
                        Content="Полностью"
                        Background="#1E90FF"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>
                <Button x:Name="TimeInterval1Min"
                        Content="1 мин"
                        Background="#EBEBEB"
                        Foreground="#666666"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>
                <Button x:Name="TimeInterval5Min"
                        Content="5 мин"
                        Background="#EBEBEB"
                        Foreground="#666666"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>
                <Button x:Name="TimeInterval10Min"
                        Content="10 мин"
                        Background="#EBEBEB"
                        Foreground="#666666"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Cursor="Hand"/>
            </WrapPanel>
            
            <!-- Контейнер для графика вовлечённости -->
            <Border x:Name="EngagementChartContainer"
                    Background="#FAFAFA"
                    CornerRadius="4"
                    Grid.Row="2">
                <!-- Здесь будет рендериться график из бэка -->
                <TextBlock Text="График вовлечённости загрузится здесь"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>