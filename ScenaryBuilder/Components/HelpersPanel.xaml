<UserControl x:Class="EmotionAnalyzer.Components.HelperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EmotionAnalyzer.Components">
    
    <Grid>
        <!-- Основной контент аналитики (виден по умолчанию) -->
        <Border x:Name="AnalyticsPanel"
                Background="#FFFFFF"
                BorderThickness="1"
                BorderBrush="#E0E0E0"  
                CornerRadius="8"
                Padding="24">
            
            <Grid SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок -->
                <TextBlock Text="Аналитика"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#000000"
                           Margin="0,0,0,24"
                           Grid.Row="0"/>
                
                <!-- Помощник секция -->
                <Border Background="#F8F9FA"
                        CornerRadius="8"
                        Padding="16"
                        Grid.Row="1">
                    
                    <StackPanel>
                        <!-- Заголовок помощника -->
                        <TextBlock Text="Помощник"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#000000"
                                   Margin="0,0,0,12"/>
                        
                        <!-- Описание -->
                        <TextBlock Text="По итогам исследование выделили несколько точек которые были ниже среднего показателя, это точно на:"
                                   FontSize="14"
                                   Foreground="#333333"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        
                        <!-- Контейнер для временных меток высокой активности -->
                        <WrapPanel x:Name="HighActivityTimestamps"
                                   Margin="0,0,0,16">
                            <!-- Пример меток - будут добавляться из бэка -->
                            <Button Content="0:53"
                                    Background="#1E90FF"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"/>
                            <Button Content="15:23"
                                    Background="#1E90FF"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"/>
                            <Button Content="46:09"
                                    Background="#1E90FF"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    Padding="16,8"
                                    Cursor="Hand"/>
                        </WrapPanel>
                        
                        <!-- Описание низкой активности -->
                        <TextBlock Text="Точки с самым наивысшим количеством активности"
                                   FontSize="14"
                                   Foreground="#333333"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        
                        <!-- Контейнер для временных меток низкой активности -->
                        <WrapPanel x:Name="LowActivityTimestamps"
                                   Margin="0,0,0,16">
                            <!-- Пример меток -->
                            <Button Content="1:59"
                                    Background="#1E90FF"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"/>
                            <Button Content="08:34"
                                    Background="#1E90FF"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    Cursor="Hand"/>
                            <Button Content="59:10"
                                    Background="#1E90FF"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    Padding="16,8"
                                    Cursor="Hand"/>
                        </WrapPanel>
                        
                        <!-- Средний показатель -->
                        <TextBlock Text="Средний показатель по видео:"
                                   FontSize="14"
                                   Foreground="#333333"
                                   Margin="0,0,0,8"/>
                        
                        <TextBlock x:Name="AverageMetric"
                                   Text="Радость"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#1E90FF"/>
                    </StackPanel>
                </Border>
                
                <!-- Кнопки - ПО ЦЕНТРУ -->
                <StackPanel Grid.Row="2" 
                            Orientation="Vertical" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,24,0,0">
                    
                    <!-- Кнопка полного результата -->
                    <Button x:Name="OpenFullResultsButton"
                            Content="Открыть полный результат по тесту"
                            Background="#1E90FF"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Height="48"
                            Width="380"
                            FontSize="14"
                            Padding="50,0"
                            Margin="0,0,0,12"
                            Cursor="Hand"
                            Click="OpenFullResultsButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="15,8">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#005A9E"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#004A9E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Кнопка обратной связи -->
                    <Button x:Name="OpenFeedbackButton"
                            Content="💬 Обратная связь"
                            Background="#1E90FF"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Height="48"
                            Width="380"
                            FontSize="14"
                            Padding="50,0"
                            Cursor="Hand"
                            Click="OpenFeedbackButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="15,8">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#005A9E"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#004A9E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Форма обратной связи (скрыта по умолчанию) -->
        <local:FeedbackForm x:Name="FeedbackFormComponent"
                            Visibility="Collapsed"
                            FormSubmitted="FeedbackForm_Submitted"
                            FormCancelled="FeedbackForm_Cancelled"/>
    </Grid>
</UserControl>