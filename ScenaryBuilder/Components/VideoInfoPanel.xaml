<UserControl x:Class="EmotionAnalyzer.Components.VideoInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"  
            CornerRadius="8"
            Padding="24">
        
        <Grid SnapsToDevicePixels="True"
          UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок -->
            <TextBlock Text="Сведение о видео"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#000000"
                       Margin="0,0,0,16"
                       Grid.Row="0"/>
            
            <!-- Контейнер для видео плеера -->
            <Border x:Name="VideoPlayerContainer"
                    Background="#000000"
                    CornerRadius="8"
                    Grid.Row="1"
                    Margin="0,0,0,16">
                <!-- Здесь будет видео плеер -->
                <TextBlock Text="Видео плеер будет загружен здесь"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            
            <!-- Контролы видео -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button x:Name="PlayPauseButton"
                            Content="▶"
                            Width="48"
                            Height="48"
                            FontSize="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,16,0"/>
                    <Button x:Name="Rewind5Button"
                            Content="⏪"
                            Width="40"
                            Height="40"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,16,0"/>
                    <Button x:Name="Forward5Button"
                            Content="⏩"
                            Width="40"
                            Height="40"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <TextBlock x:Name="VideoTimestamp"
                               Text="14:53 / 1:00:00"
                               FontSize="14"
                               Foreground="#333333"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Button x:Name="FullscreenButton"
                            Content="⛶"
                            Width="40"
                            Height="40"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
            
            <!-- Информация о видео -->
            <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Padding="16"
                    Grid.Row="3"
                    Margin="0,0,0,16">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Название -->
                    <TextBlock Text="Название"
                               FontSize="12"
                               Foreground="#666666"
                               Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="VideoTitle"
                               Text="Без названия-01"
                               FontSize="14"
                               Foreground="#000000"
                               Grid.Row="1"
                               Grid.Column="0"
                               Margin="0,0,0,12"/>
                    
                    <!-- Формат -->
                    <TextBlock Text="Формат видео"
                               FontSize="12"
                               Foreground="#666666"
                               Grid.Row="0"
                               Grid.Column="1"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="VideoFormat"
                               Text="MP4"
                               FontSize="14"
                               Foreground="#000000"
                               Grid.Row="1"
                               Grid.Column="1"
                               Margin="0,0,0,12"/>
                    
                    <!-- Размер файла -->
                    <TextBlock Text="Размер файла"
                               FontSize="12"
                               Foreground="#666666"
                               Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="VideoSize"
                               Text="325.2 MB"
                               FontSize="14"
                               Foreground="#000000"
                               Grid.Row="3"
                               Grid.Column="0"
                               Margin="0,0,0,12"/>
                    
                    <!-- Качество -->
                    <TextBlock Text="Качество"
                               FontSize="12"
                               Foreground="#666666"
                               Grid.Row="2"
                               Grid.Column="1"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="VideoQuality"
                               Text="4K"
                               FontSize="14"
                               Foreground="#000000"
                               Grid.Row="3"
                               Grid.Column="1"
                               Margin="0,0,0,12"/>
                    
                    <!-- Длительность -->
                    <TextBlock Text="Длительность"
                               FontSize="12"
                               Foreground="#666666"
                               Grid.Row="4"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="VideoDuration"
                               Text="1:00:00"
                               FontSize="14"
                               Foreground="#000000"
                               Grid.Row="5"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"/>
                </Grid>
            </Border>
            
            <!-- Кнопки действий -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="HeatmapButton"
                        Content="🗺 Тепловая карта"
                        Background="#EBEBEB"
                        Foreground="#333333"
                        BorderThickness="0"
                        Height="48"
                        FontSize="14"
                        Cursor="Hand"
                        Grid.Column="0"/>
                
                <Button x:Name="UploadVideoButton"
                        Content="+ Загрузить видео"
                        Background="#EBEBEB"
                        Foreground="#333333"
                        BorderThickness="0"
                        Height="48"
                        FontSize="14"
                        Cursor="Hand"
                        Grid.Column="2"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>