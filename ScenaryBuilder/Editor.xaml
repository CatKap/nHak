<Window x:Class="ScenaryBuilder.Editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"

        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#191A1C"

        d:DesignWidth="1600"
        d:DesignHeight="900">

    <Window.Resources>
        <!-- Шаблон для отображения только картинки в выбранном элементе ComboBox -->
        <DataTemplate x:Key="SelectedItemTemplate">
            <Image Source="{Binding Image}"
                   Width="12"
                   Height="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#191A1C" />
            <Setter Property="BorderBrush" Value="#3D3E40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3574EF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White"
                                 Stroke="#3574EF"
                                 StrokeThickness="1"
                                 Width="12"
                                 Height="12">
                            <Ellipse.Effect>
                                <DropShadowEffect ShadowDepth="1"
                                                  BlurRadius="2"
                                                  Color="#40000000" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" x:Key="VerticalScrollBarStyle">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="#111111" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#3D3E40" CornerRadius="5" Margin="3,5,3,5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomProgressSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="RootGrid" Background="Transparent">
                            <!-- Трек -->
                            <Border x:Name="TrackBackground"
                                    Background="#3D3E40"
                                    Height="4"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch" />

                            <!-- Прогресс -->
                            <Border x:Name="ProgressFill"
                                    Background="#3574EF"
                                    Height="4"
                                    CornerRadius="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Width="0" />

                            <!-- Track для синхронизации Thumb -->
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Mode=TwoWay}"
                                   IsDirectionReversed="False"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Stretch"
                                   Height="12">
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand"
                                           VerticalAlignment="Center">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="12" Height="12"
                                                        Background="#191A1C"
                                                        CornerRadius="6"
                                                        BorderBrush="#ffffff"
                                                        BorderThickness="6" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <Image Source="pack://application:,,,/Resources/dreamer_logo.ico" Width="18" Height="18" />
                    <TextBlock Text="Dream" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="5,0" />
                </StackPanel>

                <Button Width="34" Height="34" DockPanel.Dock="Right"
                        Background="Transparent" BorderBrush="Transparent"
                        Click="CloseButton_Click" HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Image Source="pack://application:,,,/Resources/close.ico"
                                       Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="10,0,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="175" Height="28" HorizontalAlignment="Left" Margin="0,0,0,0" Grid.Column="0"
                    Background="Transparent" BorderBrush="#3D3E40" BorderThickness="1" CornerRadius="4">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Комбобокс для выбора типа столбца -->
                    <ComboBox x:Name="ColumnTypeComboBox"
                              Width="80"
                              Height="24"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              Foreground="White"
                              SelectedIndex="0">

                        <!-- Стиль для ComboBox -->
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="#3D3E40" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <ToggleButton x:Name="ToggleButton"
                                                              Grid.Column="2"
                                                              Focusable="false"
                                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                              ClickMode="Press"
                                                              Background="Transparent"
                                                              BorderBrush="Transparent">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate>
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="1">
                                                                <Path x:Name="Arrow"
                                                                      Fill="White"
                                                                      Margin="0,0,50,0"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Data="M0,0 L4,4 8,0 z" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>

                                                <!-- ContentPresenter для отображения картинки выбранного элемента -->
                                                <ContentPresenter x:Name="ContentSite"
                                                                  IsHitTestVisible="False"
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{StaticResource SelectedItemTemplate}"
                                                                  Margin="25,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left" />

                                                <TextBox x:Name="PART_EditableTextBox"
                                                         Style="{x:Null}"
                                                         Background="Transparent"
                                                         Foreground="Transparent"
                                                         Visibility="Hidden"
                                                         IsReadOnly="True" />
                                                <Popup x:Name="Popup"
                                                       Placement="Bottom"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Slide">
                                                    <Grid x:Name="DropDown"
                                                          SnapsToDevicePixels="True"
                                                          MinWidth="{TemplateBinding ActualWidth}"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                        <Border x:Name="DropDownBorder"
                                                                Background="#191A1C"
                                                                BorderBrush="#3D3E40"
                                                                BorderThickness="1" />
                                                        <ScrollViewer SnapsToDevicePixels="True">
                                                            <ItemsPresenter
                                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Style>

                        <!-- Стиль для элементов ComboBox -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#3574EF" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3574EF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#888" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Image Source="{Binding Image}" Width="12" Height="12" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Rectangle Width="1" Height="20" Fill="#3D3E40" Margin="-65,0,0,0" />

                    <!-- Кнопка "Добавить столбец" -->
                    <Button x:Name="AddColumnButton"
                            Content="Добавить столбец"
                            Click="AddColumnButton_Click"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Margin="-20,0,0,0"
                            BorderThickness="0"
                            FocusVisualStyle="{x:Null}" />
                </StackPanel>
            </Border>

            <Border Width="180" Height="28"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="#3D3E40"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                    <!-- Текст -->
                    <TextBlock Text="Размер шрифта" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="White" />

                    <!-- Иконка -->
                    <Image Source="pack://application:,,,/Resources/text.ico"
                           Width="12" Height="12"
                           VerticalAlignment="Center"
                           Margin="5,0,5,0" />

                    <!-- Разделитель -->
                    <Rectangle Width="1" Height="20" Fill="#3D3E40" Margin="5,0,5,0" />

                    <!-- Поле ввода размера -->
                    <TextBox x:Name="FontSizeBox"
                             Text="12"
                             Width="40"
                             VerticalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Background="Transparent"
                             Foreground="White"
                             BorderBrush="Transparent"
                             BorderThickness="0"
                             CaretBrush="White"
                             FocusVisualStyle="{x:Null}"
                             KeyDown="FontSizeBox_KeyDown"
                             PreviewTextInput="FontSizeBox_PreviewTextInput"
                             DataObject.Pasting="OnPaste" />
                </StackPanel>
            </Border>

            <Border Width="Auto" Height="28"
                    Grid.Column="2"
                    x:Name="PlayerPanel"
                    Background="Transparent"
                    BorderBrush="#3D3E40"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Margin="10,0,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="AudioFileNameText"
                               Text="Нет звука"
                               VerticalAlignment="Center"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"
                               Margin="5,0,10,0" />

                    <Rectangle Grid.Column="1"
                               Width="1" Height="20"
                               Fill="#3D3E40"
                               VerticalAlignment="Center"
                               Margin="0,0,0,0" />

                    <!-- Кнопка Play -->
                    <Button Grid.Column="2"
                            x:Name="PlayButton"
                            Width="24" Height="24"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="PlayButton_Click"
                            Margin="0,0,0,0"
                            ToolTip="Воспроизвести">
                        <Image Source="pack://application:,,,/Resources/play.ico"
                               Width="12" Height="12" />
                    </Button>

                    <!-- Кнопка Pause -->
                    <Button Grid.Column="2"
                            x:Name="PauseButton"
                            Width="24" Height="24"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="PauseButton_Click"
                            Margin="2,0,2,0"
                            ToolTip="Пауза"
                            Visibility="Collapsed">
                        <Image Source="pack://application:,,,/Resources/pause.ico"
                               Width="12" Height="12" />
                    </Button>

                    <Rectangle Grid.Column="3"
                               Width="1" Height="20"
                               Fill="#3D3E40"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="4"
                            Width="120"
                            Height="22"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            TickFrequency="0.01"
                            IsMoveToPointEnabled="True"
                            SmallChange="0.01"
                            LargeChange="0.1"
                            Margin="0,0,10,0"
                            Style="{StaticResource CustomProgressSlider}"
                            PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="ProgressSlider_ValueChanged" />

                    <TextBlock Grid.Column="5"
                               x:Name="TimeText"
                               Text="0:00 / 0:00"
                               Foreground="#A0A0A0"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               FontSize="11" />

                    <!-- Кнопка Stop -->
                    <Button Grid.Column="5"
                            x:Name="StopButton"
                            Width="24" Height="24"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="StopButton_Click"
                            Margin="10,0,10,0"
                            ToolTip="Остановить">
                        <Image Source="pack://application:,,,/Resources/stop.ico"
                               Width="12" Height="12" />
                    </Button>

                </Grid>
            </Border>


        </Grid>

        <Border Grid.Row="2" Margin="10,9,10,0" Background="#111111" CornerRadius="10">

            <DataGrid x:Name="ActionsTable"
                      SelectionUnit="Cell"
                      Background="Transparent"
                      HeadersVisibility="Column"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      RowHeight="NaN"
                      CanUserAddRows="False"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      FontSize="14"

                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <!-- Заголовки -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#3D3E40" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="BorderBrush" Value="#3D3E40" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="5,2,5,2" /> <!-- отступы заголовка -->
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Стиль ячеек -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="Transparent" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#3D3E40" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                        <Setter Property="Padding" Value="5,2,5,2" />
                        <Style.Triggers>
                            <!-- Когда ячейка выделена -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#0095FF" />
                                <Setter Property="BorderThickness" Value="1" /> <!-- толщина рамки при выделении -->
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Resources>
                    <Style TargetType="TextBox" x:Key="EditingTextBoxStyle">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="5,2,5,2" />
                    </Style>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource VerticalScrollBarStyle}" />

                </DataGrid.Resources>

            </DataGrid>

        </Border>

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="WordsCountText" Grid.Column="0" Text="Слов: 0" Foreground="#545557" 
                       VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Right" />

            <TextBlock Grid.Column="1" Text="C://user/project" Foreground="#545557" VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="5,0,10,0"
                       x:Name="ProjectFolderTextView" />

        </Grid>

    </Grid>
</Window>