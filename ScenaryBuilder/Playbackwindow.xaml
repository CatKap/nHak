<Window x:Class="ScenaryBuilder.PlaybackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Playback" 
        Height="550" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="#FF007ACC"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FF252526" Padding="10">
            <TextBlock Text="Video Player" 
                      Foreground="White" 
                      FontSize="16" 
                      FontWeight="Bold"/>
        </Border>
        
        <!-- Основная область с видео -->
        <Border Grid.Row="1" Margin="10" Background="Black">
            <MediaElement x:Name="VideoPlayer"
                         Stretch="Uniform"
                         LoadedBehavior="Manual"
                         MediaOpened="VideoPlayer_MediaOpened"
                         MediaEnded="VideoPlayer_MediaEnded"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
        </Border>
        
        <!-- Панель управления -->
        <Border Grid.Row="2" Background="#FF252526" Padding="10">
            <StackPanel>
                <!-- Прогресс-бар -->
                <ProgressBar x:Name="ProgressBar" 
                            Margin="0,0,0,10"
                            ValueChanged="ProgressBar_ValueChanged"/>
                
                <!-- Время видео -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="CurrentTimeText" 
                              Text="00:00" 
                              Foreground="LightGray"
                              HorizontalAlignment="Left"/>
                    
                    <TextBlock Grid.Column="1" 
                              Text="/" 
                              Foreground="LightGray"
                              Margin="5,0"/>
                    
                    <TextBlock x:Name="TotalTimeText" 
                              Grid.Column="2"
                              Text="00:00" 
                              Foreground="LightGray"
                              HorizontalAlignment="Right"/>
                </Grid>
                
                <!-- Кнопки управления -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="LoadButton" 
                           Content="📁 Load Video" 
                           Click="LoadButton_Click"
                           Width="120"/>
                    
                    <Button x:Name="PlayPauseButton" 
                           Content="▶ Play" 
                           Click="PlayPauseButton_Click"
                           Width="120"/>
                    
                    <Button x:Name="StopButton" 
                           Content="⏹ Stop" 
                           Click="StopButton_Click"
                           Width="120"/>
                    
                    <Button Content="🔊 Volume" 
                           Click="VolumeButton_Click"
                           Width="80"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>