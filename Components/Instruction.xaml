<Window x:Class="WpfApp2.Instruction"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Проверка положения устройства" Height="390" Width="350">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Картинка -->
        <Image Source="Images/brain.png"
               Width="100"
               Height="100"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,20,0,0"
               Stretch="Uniform"
               Grid.Row="0"/>

        <!-- Текст о необходимости убедиться в правильности положения -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="20,20,20,10">
            
            <TextBlock Text="Убедитесь в правильности"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#333333"
                       Margin="0,0,0,2"/>
            
            <TextBlock Text="положения устройства"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#333333"
                       Margin="0,0,0,2"/>
            
            <TextBlock Text="Все индикаторы должны быть голубыми"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="#666666"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Индикаторы -->
        <Grid Grid.Row="2" 
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" 
                        Margin="20,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="O1"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <Border Width="26"
                        Height="26"
                        CornerRadius="40"
                        Background="#E0E0E0"
                        BorderThickness="3"
                        BorderBrush="#CCCCCC">
                    <Ellipse x:Name="O1StatusIndicator"
                             Width="20"
                             Height="20"
                             Fill="#1E90FF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                
            </StackPanel>
            
            <StackPanel Grid.Column="1" 
                        Margin="20,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="O2"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <Border Width="26"
                        Height="26"
                        CornerRadius="40"
                        Background="#E0E0E0"
                        BorderThickness="3"
                        BorderBrush="#CCCCCC">
                    <Ellipse x:Name="O2StatusIndicator"
                             Width="20"
                             Height="20"
                             Fill="#1E90FF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
                
            </StackPanel>
            
            <StackPanel Grid.Column="2" 
                        Margin="20,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="T3"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <Border Width="26"
                        Height="26"
                        CornerRadius="40"
                        Background="#E0E0E0"
                        BorderThickness="3"
                        BorderBrush="#CCCCCC">
                    <Ellipse x:Name="T3StatusIndicator"
                             Width="20"
                             Height="20"
                             Fill="#1E90FF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            
            <StackPanel Grid.Column="3" 
                        Margin="20,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="T4"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <Border Width="26"
                        Height="26"
                        CornerRadius="40"
                        Background="#E0E0E0"
                        BorderThickness="3"
                        BorderBrush="#CCCCCC">
                    <Ellipse x:Name="T4StatusIndicator"
                             Width="20"
                             Height="20"
                             Fill="#1E90FF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
        
        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="3" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Top"
                    Margin="0,30,0,20">
            
            <Border CornerRadius="10"
                    Background="#1E90FF"
                    Padding="4">
                <Button x:Name="StatisticsButton"
                        Width="100" 
                        Height="30" 
                        Content="Закрыть"
                        Background="Transparent"
                        Foreground="#fff"
                        BorderThickness="0"
                        FontSize="16"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Click="StatisticsButton_Click">
                    
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="3" 
                                          Opacity="0.3" 
                                          BlurRadius="5"/>
                    </Button.Effect>
                </Button>
            </Border>
        </StackPanel>
    </Grid>
</Window>