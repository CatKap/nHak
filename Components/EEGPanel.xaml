<UserControl x:Class="EmotionAnalyzer.Components.EEGPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:local="clr-namespace:EmotionAnalyzer.Components">
    
    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"  
            CornerRadius="8"
            Padding="24">
        
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок ЭЭГ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Спектральные волны (BrainBit)"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#000000"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="ЭЭГ"
                               FontSize="14"
                               Foreground="#999999"
                               Margin="0,0,16,0"/>
                    <TextBlock x:Name="JoyIndicator"
                               Text="Нейтральное состояние"
                               FontSize="14"
                               Foreground="#1E90FF"/>
                </StackPanel>
            </Grid>
            
            <!-- Статистика в реальном времени -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                        <TextBlock x:Name="AlphaValueText"
                                   Text="α: 0%"
                                   FontSize="12"
                                   Foreground="#4169E1"
                                   FontWeight="Bold"/>
                    </Border>
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                        <TextBlock x:Name="BetaValueText"
                                   Text="β: 0%"
                                   FontSize="12"
                                   Foreground="#32CD32"
                                   FontWeight="Bold"/>
                    </Border>
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                        <TextBlock x:Name="GammaValueText"
                                   Text="γ: 0%"
                                   FontSize="12"
                                   Foreground="#FF4500"
                                   FontWeight="Bold"/>
                    </Border>
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                        <TextBlock x:Name="ThetaValueText"
                                   Text="θ: 0%"
                                   FontSize="12"
                                   Foreground="#8A2BE2"
                                   FontWeight="Bold"/>
                    </Border>
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="12">
                        <TextBlock x:Name="DeltaValueText"
                                   Text="δ: 0%"
                                   FontSize="12"
                                   Foreground="#4682B4"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
            
            <!-- График основных волн (Альфа и Бета) -->
            <Border Grid.Row="2" 
                    Background="#FAFAFA" 
                    CornerRadius="4" 
                    Margin="0,0,0,12"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Альфа (α) и Бета (β) волны"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#333333"/>
                        <TextBlock x:Name="AlphaBetaStatus"
                                   Text="Альфа: Расслабление | Бета: Активность"
                                   FontSize="12"
                                   Foreground="#666666"
                                   Margin="16,0,0,0"/>
                    </StackPanel>
                    
                    <lvc:CartesianChart x:Name="AlphaBetaChart"
                                        Grid.Row="1"
                                        Hoverable="False"
                                        DataTooltip="{x:Null}"
                                        DisableAnimations="True">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Альфа (α)"
                                          Values="{Binding AlphaData}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#4169E1"
                                          StrokeThickness="2"
                                          Fill="Transparent"/>
                            <lvc:LineSeries Title="Бета (β)"
                                          Values="{Binding BetaData}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#32CD32"
                                          StrokeThickness="2"
                                          Fill="Transparent"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Время (сек)"
                                    LabelFormatter="{Binding XAxisFormatter}"
                                    Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="% от общей мощности"
                                    MinValue="0"
                                    MaxValue="100"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
            
            <!-- График второстепенных волн -->
            <Border Grid.Row="3" 
                    Background="#FAFAFA" 
                    CornerRadius="4"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Гамма (γ), Тета (θ), Дельта (δ) волны"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,0,0,8"/>
                    
                    <lvc:CartesianChart x:Name="GammaThetaDeltaChart"
                                        Grid.Row="1"
                                        Hoverable="False"
                                        DataTooltip="{x:Null}"
                                        DisableAnimations="True">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Гамма (γ)"
                                          Values="{Binding GammaData}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#FF4500"
                                          StrokeThickness="2"
                                          Fill="Transparent"/>
                            <lvc:LineSeries Title="Тета (θ)"
                                          Values="{Binding ThetaData}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#8A2BE2"
                                          StrokeThickness="2"
                                          Fill="Transparent"/>
                            <lvc:LineSeries Title="Дельта (δ)"
                                          Values="{Binding DeltaData}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#4682B4"
                                          StrokeThickness="2"
                                          Fill="Transparent"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Время (сек)"
                                    LabelFormatter="{Binding XAxisFormatter}"
                                    Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="% от общей мощности"
                                    MinValue="0"
                                    MaxValue="100"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>