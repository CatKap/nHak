<UserControl x:Class="EmotionAnalyzer.Components.EngagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:local="clr-namespace:EmotionAnalyzer.Components">
    
    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"  
            CornerRadius="8"
            Padding="24">
        
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок и статус -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="📊 Анализ"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#FF6B6B" Margin="0,0,4,0"/>
                            <TextBlock x:Name="CurrentBetaText"
                                       Text="Бета: 0.00%"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Background="#F8F9FA" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#4ECDC4" Margin="0,0,4,0"/>
                            <TextBlock x:Name="CurrentAlphaText"
                                       Text="Альфа: 0.00%"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </Grid>
            
            <!-- Легенда и переключатели -->
            <Border Grid.Row="1" 
                    Background="#F8F9FA" 
                    CornerRadius="4" 
                    Margin="0,0,0,16"
                    Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Легенда -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <Rectangle Width="16" Height="3" Fill="#FF6B6B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Бета (β): концентрация" 
                                       FontSize="11" 
                                       Foreground="#666666"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="3" Fill="#4ECDC4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Альфа (α): расслабление" 
                                       FontSize="11" 
                                       Margin="0,0,10,0"
                                       Foreground="#666666"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="#E8F4FD" CornerRadius="4" Padding="8,4">
                            <TextBlock x:Name="EngagementStatusText"
                                       Text="Ожидание данных..."
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#2980B9"/>
                        </Border>
                    </StackPanel>
                        
                    </Grid>
            </Border>
            
            <!-- График бета-волн -->
            <Border Grid.Row="2" 
                    Background="#FFFFFF" 
                    CornerRadius="4" 
                    BorderThickness="1"
                    BorderBrush="#E0E0E0"
                    Margin="0,0,0,12"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Заголовок и статистика -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🧠 Бета-волны (β)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="BetaStatsText"
                                       Text="Мин: 0.0  Ср: 0.0  Макс: 0.0"
                                       FontSize="10"
                                       Foreground="#7F8C8D"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- График -->
                    <lvc:CartesianChart x:Name="BetaChart"
                                        Grid.Row="1"
                                        Hoverable="True"
                                        DataTooltip="{x:Null}"
                                        DisableAnimations="False"
                                        AnimationsSpeed="0:0:0.3">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Бета-волны"
                                          Values="{Binding BetaValues}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#FF6B6B"
                                          StrokeThickness="3"
                                          Fill="Transparent"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Время (секунды)"
                                    LabelFormatter="{Binding XAxisFormatter}"
                                    Foreground="#7F8C8D"
                                    FontSize="10">
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="1" Stroke="#ECF0F1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Процент %"
                                    MinValue="0"
                                    MaxValue="100"
                                    Foreground="#7F8C8D"
                                    FontSize="10">
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="1" Stroke="#ECF0F1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
            
            <!-- График альфа-волн -->
            <Border Grid.Row="3" 
                    Background="#FFFFFF" 
                    CornerRadius="4" 
                    BorderThickness="1"
                    BorderBrush="#E0E0E0"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Заголовок и статистика -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🕊️ Альфа-волны (α)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="AlphaStatsText"
                                       Text="Мин: 0.0  Ср: 0.0  Макс: 0.0"
                                       FontSize="10"
                                       Foreground="#7F8C8D"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- График -->
                    <lvc:CartesianChart x:Name="AlphaChart"
                                        Grid.Row="1"
                                        Hoverable="True"
                                        DataTooltip="{x:Null}"
                                        DisableAnimations="False"
                                        AnimationsSpeed="0:0:0.3">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Альфа-волны"
                                          Values="{Binding AlphaValues}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#4ECDC4"
                                          StrokeThickness="3"
                                          Fill="Transparent"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Время (секунды)"
                                    LabelFormatter="{Binding XAxisFormatter}"
                                    Foreground="#7F8C8D"
                                    FontSize="10">
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="1" Stroke="#ECF0F1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Процент %"
                                    MinValue="0"
                                    MaxValue="100"
                                    Foreground="#7F8C8D"
                                    FontSize="10">
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="1" Stroke="#ECF0F1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>