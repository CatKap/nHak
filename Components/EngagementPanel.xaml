<UserControl x:Class="EmotionAnalyzer.Components.EngagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:local="clr-namespace:EmotionAnalyzer.Components">
    
    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"  
            CornerRadius="8"
            Padding="24">
        
        <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок и статус -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Вовлечённость (BrainBit)"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#000000"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="EngagementStatusText"
                               Text="Ожидание данных..."
                               FontSize="14"
                               Foreground="#1E90FF"
                               Margin="0,0,16,0"/>
                    <TextBlock x:Name="CurrentAttentionText"
                               Text="Внимание: 0.00"
                               FontSize="12"
                               Foreground="#666666"/>
                </StackPanel>
            </Grid>
            
            <!-- Переключатель временных интервалов -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                <Button x:Name="TimeIntervalFull"
                        Content="Полностью"
                        Background="#1E90FF"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="TimeIntervalFull_Click"/>
                <Button x:Name="TimeInterval1Min"
                        Content="1 мин"
                        Background="#EBEBEB"
                        Foreground="#666666"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="TimeInterval1Min_Click"/>
                <Button x:Name="TimeInterval5Min"
                        Content="5 мин"
                        Background="#EBEBEB"
                        Foreground="#666666"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="TimeInterval5Min_Click"/>
                <Button x:Name="TimeInterval10Min"
                        Content="10 мин"
                        Background="#EBEBEB"
                        Foreground="#666666"
                        BorderThickness="0"
                        Padding="16,6"
                        FontSize="12"
                        Cursor="Hand"
                        Click="TimeInterval10Min_Click"/>
            </WrapPanel>
            
            <!-- График внимания -->
            <Border Grid.Row="2" 
                    Background="#FAFAFA" 
                    CornerRadius="4" 
                    Margin="0,0,0,12"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Внимание (Attention)"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,0,0,8"/>
                    
                    <lvc:CartesianChart x:Name="AttentionChart"
                                        Grid.Row="1"
                                        Hoverable="False"
                                        DataTooltip="{x:Null}"
                                        DisableAnimations="True">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Внимание"
                                          Values="{Binding AttentionData}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#1E90FF"
                                          StrokeThickness="2"
                                          Fill="Transparent"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Время (сек)"
                                    LabelFormatter="{Binding XAxisFormatter}"
                                    Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Значение"
                                    MinValue="0"
                                    MaxValue="1"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
            
            <!-- График расслабления -->
            <Border Grid.Row="3" 
                    Background="#FAFAFA" 
                    CornerRadius="4"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Расслабление (Relaxation)"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,0,0,8"/>
                    
                    <lvc:CartesianChart x:Name="RelaxationChart"
                                        Grid.Row="1"
                                        Hoverable="False"
                                        DataTooltip="{x:Null}"
                                        DisableAnimations="True">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Расслабление"
                                          Values="{Binding RelaxationData}"
                                          PointGeometry="{x:Null}"
                                          LineSmoothness="0"
                                          Stroke="#32CD32"
                                          StrokeThickness="2"
                                          Fill="Transparent"/>
                        </lvc:CartesianChart.Series>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Время (сек)"
                                    LabelFormatter="{Binding XAxisFormatter}"
                                    Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Значение"
                                    MinValue="0"
                                    MaxValue="1"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>