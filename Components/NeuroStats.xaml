<Window x:Class="ScenaryBuilder.Components.NeuroStats"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        mc:Ignorable="d"
        Title="Neuro Statistics" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        >
    
    <Window.Resources>
        <!-- Стиль для MarkdownViewer -->
        <Style x:Key="NeuroMarkdownStyle" TargetType="markdig:MarkdownViewer">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        
        <!-- Кастомные стили для Markdown -->
        <Style x:Key="NeuroDocumentStyle" TargetType="FlowDocument">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="PagePadding" Value="10"/>
            <Setter Property="LineHeight" Value="1.6"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#007ACC" Padding="15">
            <DockPanel>
                <TextBlock Text="🧠 Neuro Statistics Dashboard" 
                           Foreground="White" 
                           FontSize="18" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshBtn" 
                            Content="🔄 Refresh" 
                            Margin="5,0" 
                            Padding="10,5"
    
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"/>
                    
                    <Button x:Name="ExportBtn" 
                            Content="📊 Export" 
                            Margin="5,0" 
                            Padding="10,5"
                            Click="ExportBtn_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderBrush="White"
                            BorderThickness="1"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Основная область с Markdown -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Markdown Viewer -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="5">
                    <markdig:MarkdownViewer 
                        x:Name="MarkdownViewer"
                        Style="{StaticResource NeuroMarkdownStyle}"
                        />
                </Border>
            </ScrollViewer>
            
            <!-- Панель быстрого доступа -->
            <Border Grid.Column="1" Width="250" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
                <StackPanel Margin="10">
                    <TextBlock Text="Quick Stats" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    
                    <ListView x:Name="StatsList" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Value}" FontSize="16" Foreground="#007ACC"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    
                    <Button x:Name="UpdateMarkdownBtn" 
                            Content="Update Markdown" 
                            Margin="0,20,0,0" 
                            Padding="10,5"
                            />
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Статус бар -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#666666"/>
        </Border>
    </Grid>
</Window>