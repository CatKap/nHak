<UserControl x:Class="EmotionAnalyzer.Components.HelperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf">
    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"  
            CornerRadius="8"
            Padding="24">
        
        <Grid SnapsToDevicePixels="True"
        UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок -->
            <TextBlock Text="AI Аналитика"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#000000"
                       Margin="0,0,0,24"
                       Grid.Row="0"/>
            
            <!-- Помощник секция -->
            <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Padding="16"
                    Grid.Row="1">
                
                <StackPanel>
                    
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Padding="5">
                            <wpf:MarkdownViewer 
                                x:Name="MarkdownViewer"
                            />
                        </Border>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            
            <!-- Кнопка полного результата -->
            <Button x:Name="OpenFullResultsButton"
                    Content="Запустить ИИ аналитику"
                    Background="#1E90FF"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Height="48"
                    FontSize="14"
                    FontWeight="Bold"
                    Margin="0,24,0,0"
                    Cursor="Hand"
                    Click="OpenFullResultsButton_Click"
                    Grid.Row="2"/>
            
            <Button x:Name="OpenGropeResultsButton"
                    FontWeight="Bold"
                    Content="Аналитика группы"
                    Background="#1E90FF"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Height="48"
                    FontSize="14"
                    Margin="0,24,0,0"
                    Cursor="Hand"
                    Click="OpenFullResultsButton_Click"
                    Grid.Row="3"/>
        </Grid>
    </Border>
</UserControl>
