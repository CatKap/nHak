<UserControl x:Class="EmotionAnalyzer.Components.HelperPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#FFFFFF"
            BorderThickness="1"
            BorderBrush="#E0E0E0"  
            CornerRadius="8"
            Padding="24">
        
        <Grid SnapsToDevicePixels="True"
        UseLayoutRounding="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Заголовок -->
            <TextBlock Text="Аналитика"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#000000"
                       Margin="0,0,0,24"
                       Grid.Row="0"/>
            
            <!-- Помощник секция -->
            <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Padding="16"
                    Grid.Row="1">
                
                <StackPanel>
                    <!-- Заголовок помощника -->
                    <TextBlock Text="Помощник"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#000000"
                               Margin="0,0,0,12"/>
                    
                    <!-- Описание -->
                    <TextBlock Text="По итогам исследование выделили несколько точек которые были ниже среднего показателя, это точно на:"
                               FontSize="14"
                               Foreground="#333333"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    
                    <!-- Контейнер для временных меток высокой активности -->
                    <WrapPanel x:Name="HighActivityTimestamps"
                               Margin="0,0,0,16">
                        <!-- Пример меток - будут добавляться из бэка -->
                        <Button Content="0:53"
                                Background="#1E90FF"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="15:23"
                                Background="#1E90FF"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="46:09"
                                Background="#1E90FF"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Padding="16,8"
                                Cursor="Hand"/>
                    </WrapPanel>
                    
                    <!-- Описание низкой активности -->
                    <TextBlock Text="Точки с самым наивысшим количеством активности"
                               FontSize="14"
                               Foreground="#333333"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>
                    
                    <!-- Контейнер для временных меток низкой активности -->
                    <WrapPanel x:Name="LowActivityTimestamps"
                               Margin="0,0,0,16">
                        <!-- Пример меток -->
                        <Button Content="1:59"
                                Background="#1E90FF"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="08:34"
                                Background="#1E90FF"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Cursor="Hand"/>
                        <Button Content="59:10"
                                Background="#1E90FF"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Padding="16,8"
                                Cursor="Hand"/>
                    </WrapPanel>
                    
                    <!-- Средний показатель -->
                    <TextBlock Text="Средний показатель по видео:"
                               FontSize="14"
                               Foreground="#333333"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock x:Name="AverageMetric"
                               Text="Радость"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#1E90FF"/>
                </StackPanel>
            </Border>
            
            <!-- Кнопка полного результата -->
            <Button x:Name="OpenFullResultsButton"
                    Content="Открыть полный результат по тесту"
                    Background="#1E90FF"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Height="48"
                    FontSize="14"
                    Margin="0,24,0,0"
                    Cursor="Hand"
                    Grid.Row="2"/>
        </Grid>
    </Border>
</UserControl>
